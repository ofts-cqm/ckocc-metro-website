# Copy into .env.local. Never replace or commit the existing private .env / PEM.
# Next loads .env.local automatically. Operator npm scripts load .env then .env.local.
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
ABUSE_HASH_SECRET=
# Temporary local testing switch; only applies in development/test, never production.
DISABLE_RATE_LIMITS=false
# Per-IP new request/comment limits. Positive integers; missing/invalid values use these defaults.
NEW_REQUESTS_PER_HOUR=3
NEW_REQUESTS_PER_DAY=10
NEW_COMMENTS_PER_HOUR=10
NEW_COMMENTS_PER_DAY=30
GUEST_MENTIONS_PER_DAY=3

# PostgreSQL with verified TLS. Use the provider's pooled URL for the app.
DATABASE_URL=

# GitHub App installation scoped only to the map data repository.
GITHUB_APP_ID=5211152
GITHUB_INSTALLATION_ID=168513413
GITHUB_APP_PRIVATE_KEY=
GITHUB_OWNER=ofts-cqm
GITHUB_REPO=ckocc-metro-map
GITHUB_DEFAULT_BRANCH=main
GITHUB_BOT_LOGIN=ckocc-metro-bot[bot]
# Enable only after validating protected branches, required validate-map checks,
# strict up-to-date branches, merge commits, and bot merge permission without bypass.
# The App also needs Checks read permission to inspect validation results.
WEBSITE_MERGES_ENABLED=false
GITHUB_WEBHOOK_SECRET=
# Optional alternative to the App; leave unset when using the App.
# GITHUB_PERSONAL_ACCESS_TOKEN=

# Separate stores: private uploads and immutable public approved PNGs.
BLOB_READ_WRITE_TOKEN=
PUBLISHED_BLOB_READ_WRITE_TOKEN=

# Turnstile browser key is public; secret never has a NEXT_PUBLIC prefix.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=localhost

# Vercel sets VERCEL=1 itself. Production writes require this proxy policy.
TRUST_PROXY=vercel
# Use an independent strong secret for the repair job bearer credential.
CRON_SECRET=

# Optional transactional email. Apply migration 003 before enabling.
# AWS SDK default credential chain; use role credentials where available.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
SES_FROM_EMAIL=
SES_REPLY_TO_EMAIL=
SES_FEEDBACK_TOPIC_ARN=
EMAIL_NOTIFICATIONS_ENABLED=false
# Maximum distinct notification emails per account per UTC calendar day.
# Verification mail uses separate abuse limits. Invalid/missing values default to 5.
EMAIL_NOTIFICATIONS_PER_DAY=5
# Optional independent 32+ character link-signing secret; defaults to BETTER_AUTH_SECRET.
# Changing it invalidates pending verification emails. Keep stable across instances.
EMAIL_TOKEN_SECRET=
