# Copy into .env.local. Never replace or commit the existing private .env / PEM.
# Next loads .env.local automatically. Operator npm scripts load .env then .env.local.
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
ABUSE_HASH_SECRET=
# Temporary local testing switch; only applies in development/test, never production.
DISABLE_RATE_LIMITS=false

# PostgreSQL with verified TLS. Use the provider's pooled URL for the app.
DATABASE_URL=

# GitHub App installation scoped only to the map data repository.
GITHUB_APP_ID=5211152
GITHUB_INSTALLATION_ID=168513413
GITHUB_APP_PRIVATE_KEY=
GITHUB_OWNER=ofts-cqm
GITHUB_REPO=ckocc-metro-map
GITHUB_DEFAULT_BRANCH=main
GITHUB_BOT_LOGIN=ckocc-metro-bot[bot]
GITHUB_WEBHOOK_SECRET=
# Optional alternative to the App; leave unset when using the App.
# GITHUB_PERSONAL_ACCESS_TOKEN=

# Separate stores: private uploads and immutable public approved PNGs.
BLOB_READ_WRITE_TOKEN=
PUBLISHED_BLOB_READ_WRITE_TOKEN=

# Turnstile browser key is public; secret never has a NEXT_PUBLIC prefix.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=localhost

# Vercel sets VERCEL=1 itself. Production writes require this proxy policy.
TRUST_PROXY=vercel
# Use an independent strong secret for the repair job bearer credential.
CRON_SECRET=
